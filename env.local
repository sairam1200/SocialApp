NODE_ENV=development
# Service
PROJECT_NAME=Gaddr Backend
# Port number
APP_URL=http://localhost:3000
AUTH_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PORT=3000
# Encryption
ENCRYPTION_KEY=
ENCRYPTION_ALGORITHM=AES-256-CBC
ENCRYPTION_IV=
ENCRYPTION_ENCODING=base64
# JWT
JWT_SECRET=
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:3000
JWT_ACCESS_EXPIRATION_MINUTES=7d
JWT_REFRESH_EXPIRATION_HOURS=30d
# Postgress
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USERNAME=root
POSTGRES_PASSWORD=
POSTGRES_DATABASE=gaddr-development
POSTGRES_SYNCHRONIZE=false
POSTGRES_ENTITIES=/../../**/entities/**/*.entity.{js,ts}
POSTGRES_MIGRATIONS=/../../**/migrations/*.{js,ts}
POSTGRES_MIGRATIONS_RUN=true
# Redis
REDIS_HOST=localhost
REDIS_PORT=6349
REDIS_PASSWORD=
# Winston
LOG_DIR = "./logs/"

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
